{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dh118713-oss/easyeda-execution-skill/schemas/eda-operation-plan.schema.json",
  "title": "EasyEDA execution operation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "scope", "sources", "target", "approval", "operations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["beginner_simple", "intermediate", "advanced_manual_review", "unsupported_without_specialist_input"]},
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["design_intent_revision", "schematic_revision", "board_revision", "constraints_revision", "pcb_constraints_revision"],
      "properties": {
        "design_intent_revision": {"type": "string", "minLength": 1},
        "schematic_revision": {"type": "string", "minLength": 1},
        "board_revision": {"type": "string", "minLength": 1},
        "constraints_revision": {"type": "string", "minLength": 1},
        "pcb_constraints_revision": {"type": "string", "minLength": 1},
        "design_intent_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "pcb_constraints_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "target": {"$ref": "#/$defs/target"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "approved_revisions", "approved_scope"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string", "format": "date-time"},
        "manual_review_id": {"type": "string", "minLength": 1},
        "approved_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approved_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["inspect", "schematic", "sync_pcb", "placement", "routing", "copper", "erc", "drc", "save", "readback"]}}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dry_run": {"type": "boolean"},
        "close_reopen_for_readback": {"type": "boolean"},
        "allow_intermediate_with_human_review": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {"kind": {"enum": ["sync_schematic_to_pcb", "place_components", "route_nets", "create_copper", "run_drc"]}},
              "required": ["kind"]
            }
          }
        }
      },
      "then": {"properties": {"sources": {"required": ["pcb_constraints_revision"]}}}
    },
    {
      "if": {"properties": {"scope": {"enum": ["advanced_manual_review", "unsupported_without_specialist_input"]}}, "required": ["scope"]},
      "then": {
        "properties": {
          "operations": {
            "not": {"contains": {"properties": {"kind": {"enum": ["apply_schematic", "sync_schematic_to_pcb", "place_components", "route_nets", "create_copper", "save"]}}, "required": ["kind"]}}
          }
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "intermediate"}}, "required": ["scope"]},
      "then": {
        "required": ["options"],
        "properties": {
          "options": {"required": ["allow_intermediate_with_human_review"], "properties": {"allow_intermediate_with_human_review": {"const": true}}},
          "approval": {"required": ["approved_by", "approved_at", "manual_review_id"], "properties": {"approved": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"approval": {"properties": {"approved": {"const": false}}, "required": ["approved"]}}, "required": ["approval"]},
      "then": {
        "properties": {
          "operations": {
            "not": {"contains": {"properties": {"kind": {"enum": ["apply_schematic", "sync_schematic_to_pcb", "place_components", "route_nets", "create_copper", "run_erc", "run_drc", "save", "close_reopen"]}}, "required": ["kind"]}}
          }
        }
      }
    }
  ],
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "documents"],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "project": {
          "type": "object", "additionalProperties": false,
          "required": ["uuid", "name"],
          "properties": {"uuid": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}
        },
        "documents": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["uuid", "type", "revision"],
            "properties": {
              "uuid": {"type": "string", "minLength": 1},
              "type": {"type": "string", "enum": ["schematic", "schematic_page", "pcb"]},
              "path": {"type": "string"}, "revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "requires_approval"],
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"enum": ["apply_schematic", "sync_schematic_to_pcb", "place_components", "route_nets", "create_copper", "run_erc", "run_drc", "save", "close_reopen"]}},
            "required": ["kind"]
          },
          "then": {"properties": {"requires_approval": {"const": true}}}
        }
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["inspect_identity", "open_project", "open_document", "confirm_revision", "apply_schematic", "sync_schematic_to_pcb", "place_components", "route_nets", "create_copper", "run_erc", "run_drc", "save", "close_reopen", "readback"]},
        "document_uuid": {"type": "string", "minLength": 1},
        "requires_approval": {"type": "boolean"},
        "inputs": {"type": "object"},
        "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
