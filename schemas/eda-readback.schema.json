{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dh118713-oss/easyeda-execution-skill/schemas/eda-readback.schema.json",
  "title": "EasyEDA execution readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "status", "sources", "target", "board_revision", "operations", "design_review"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["planned", "running", "completed", "partial", "blocked", "needs_input", "revision_mismatch", "api_error", "manual_review"]},
    "sources": {"$ref": "#/$defs/sources"},
    "target": {"$ref": "#/$defs/target"},
    "board_revision": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "checks": {
      "type": "object", "additionalProperties": false,
      "properties": {"erc": {"$ref": "#/$defs/check"}, "drc": {"$ref": "#/$defs/check"}}
    },
    "design_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "human_review_required", "issues"],
      "properties": {
        "status": {"type": "string", "enum": ["not_assessed", "issues_found", "human_review_required", "ready_for_beginner_review"]},
        "human_review_required": {"type": "boolean"}, "issues": {"type": "array", "items": {"type": "string"}}, "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["design_intent_revision", "schematic_revision", "board_revision", "constraints_revision", "pcb_constraints_revision"],
      "properties": {
        "design_intent_revision": {"type": "string", "minLength": 1},
        "schematic_revision": {"type": "string", "minLength": 1},
        "board_revision": {"type": "string", "minLength": 1},
        "constraints_revision": {"type": "string", "minLength": 1},
        "pcb_constraints_revision": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "documents"],
      "properties": {
        "window_id": {"type": "string"},
        "project": {"type": "object", "additionalProperties": false, "required": ["uuid", "name"], "properties": {"uuid": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "path": {"type": "string"}}},
        "documents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["uuid", "type", "revision"], "properties": {"uuid": {"type": "string", "minLength": 1}, "type": {"type": "string", "enum": ["schematic", "schematic_page", "pcb"]}, "path": {"type": "string"}, "revision": {"type": "string", "minLength": 1}}}}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["completed", "partial", "blocked", "needs_input", "revision_mismatch", "api_error", "skipped"]},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "api_method": {"type": "string"}, "result": {}, "error": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "raw_result"],
      "properties": {"status": {"type": "string", "enum": ["not_run", "passed", "failed", "error", "incomplete"]}, "raw_result": {}, "error_count": {"type": "integer", "minimum": 0}, "errors": {"type": "array", "items": {"type": "object"}}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["api_result", "document_identity", "document_snapshot", "erc", "drc", "save", "reopen", "manual_note"]}, "summary": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "format": "date-time"}, "location": {"type": "string"}}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "completed"},
          "operations": {"contains": {"properties": {"kind": {"const": "run_erc"}}, "required": ["kind"]}}
        },
        "required": ["status", "operations"]
      },
      "then": {
        "required": ["checks"],
        "properties": {
          "checks": {"required": ["erc"], "properties": {"erc": {"properties": {"status": {"enum": ["passed", "failed", "error"]}}, "required": ["status", "raw_result"]}}},
          "operations": {
            "contains": {"properties": {"kind": {"const": "run_erc"}, "status": {"const": "completed"}}, "required": ["kind", "status"]},
            "items": {"if": {"properties": {"kind": {"const": "run_erc"}}, "required": ["kind"]}, "then": {"properties": {"status": {"const": "completed"}}}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "completed"},
          "operations": {"contains": {"properties": {"kind": {"const": "run_drc"}}, "required": ["kind"]}}
        },
        "required": ["status", "operations"]
      },
      "then": {
        "required": ["checks"],
        "properties": {
          "checks": {"required": ["drc"], "properties": {"drc": {"properties": {"status": {"enum": ["passed", "failed", "error"]}}, "required": ["status", "raw_result"]}}},
          "operations": {
            "contains": {"properties": {"kind": {"const": "run_drc"}, "status": {"const": "completed"}}, "required": ["kind", "status"]},
            "items": {"if": {"properties": {"kind": {"const": "run_drc"}}, "required": ["kind"]}, "then": {"properties": {"status": {"const": "completed"}}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "required": ["checks", "evidence"],
        "properties": {
          "checks": {
            "required": ["erc", "drc"],
            "properties": {
              "erc": {"properties": {"status": {"enum": ["passed", "failed", "error"]}}, "required": ["status", "raw_result"]},
              "drc": {"properties": {"status": {"enum": ["passed", "failed", "error"]}}, "required": ["status", "raw_result"]}
            }
          },
          "operations": {
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "run_erc"}, "status": {"const": "completed"}}, "required": ["kind", "status"]}},
              {"contains": {"properties": {"kind": {"const": "run_drc"}, "status": {"const": "completed"}}, "required": ["kind", "status"]}},
              {"contains": {"properties": {"kind": {"const": "save"}, "status": {"const": "completed"}}, "required": ["kind", "status"]}},
              {"contains": {"properties": {"kind": {"const": "close_reopen"}, "status": {"const": "completed"}}, "required": ["kind", "status"]}}
            ],
            "items": {
              "if": {"properties": {"kind": {"enum": ["run_erc", "run_drc", "save", "close_reopen"]}}, "required": ["kind"]},
              "then": {"properties": {"status": {"const": "completed"}}}
            }
          },
          "evidence": {
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "erc"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "drc"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "save"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "reopen"}}, "required": ["kind"]}}
            ]
          }
        }
      }
    }
  ]
}
